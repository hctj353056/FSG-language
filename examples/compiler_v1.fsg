; ==========================================
; FSG编译器 v1.0 - 自举增强版
; 用FSG汇编实现的功能更完整的编译器
; 支持: 变量操作、循环、函数调用、字符串处理
; ==========================================

.SECTION .text
.GLOBAL _start

; ==========================================
; 入口点
; ==========================================
_start:
    CALL initCompiler
    
    ; 输出编译器信息
    LOADIMM R0, str_banner
    PRINTS str_banner
    
    ; 执行测试程序
    CALL test_all
    
    LOADIMM R0, str_done
    PRINTS str_done
    
    HALT

; ==========================================
; 编译器初始化
; ==========================================
initCompiler:
    PUSH R7
    LOADIMM R7, 0
    
    ; 初始化符号表指针
    LOADIMM R0, symbol_table
    STORE sym_ptr, R0
    
    ; 初始化代码生成器
    LOADIMM R0, code_buffer
    STORE code_ptr, R0
    
    ; 初始化rodata指针
    LOADIMM R0, 0x1000
    STORE rodata_ptr, R0
    
    POP R7
    RET

; ==========================================
; 主编译器循环
; 输入: R0 = 源码地址
; 输出: R0 = 字节码地址
; ==========================================
compile:
    PUSH R7
    LOADIMM R7, 0
    
    MOV R1, R0              ; R1 = 源码指针
compile_loop:
    ; 读取字符
    LOAD R2, R1
    CMP R2, R7              ; 检查是否为空字符
    JE compile_done
    
    ; 跳过空白字符
    CALL skip_whitespace
    
    ; 检查注释
    LOAD R2, R1
    CMP R2, R7
    JE compile_done
    
    LOADIMM R3, 0x3B        ; ';'
    CMP R2, R3
    JE skip_comment
    
    ; 检查标签
    LOADIMM R3, 0x3A        ; ':'
    ; 简化: 这里需要更复杂的解析
    
    ADD R1, R1, R7          ; R1++
    JMP compile_loop
    
skip_comment:
    LOAD R2, R1
    LOADIMM R3, 0x0A        ; '\n'
    CMP R2, R3
    JE compile_loop
    ADD R1, R1, R7
    JMP skip_comment
    
compile_done:
    POP R7
    RET

; ==========================================
; 跳过空白字符
; 输入: R1 = 源码指针
; 输出: R1 = 下一个非空字符
; ==========================================
skip_whitespace:
    PUSH R7
    LOADIMM R7, 0
    
    LOAD R2, R1
    LOADIMM R3, 0x20        ; ' '
    CMP R2, R3
    JNE skip_ws_done
    
    LOADIMM R3, 0x09        ; '\t'
    CMP R2, R3
    JNE skip_ws_done
    
    LOADIMM R3, 0x0A        ; '\n'
    CMP R2, R3
    JNE skip_ws_done
    
    ADD R1, R1, R7
    JMP skip_whitespace
    
skip_ws_done:
    POP R7
    RET

; ==========================================
; 词法分析器 - 识别令牌
; ==========================================
lex_token:
    PUSH R7
    LOADIMM R7, 0
    
    ; R1 = 当前源码位置
    ; 返回: R2 = 令牌类型, R3 = 令牌值/位置
    
    LOAD R2, R1
    CMP R2, R7
    JE token_end
    
    ; 检查是否字母开头 (标签/指令)
    LOADIMM R3, 0x41        ; 'A'
    CMP R2, R3
    JL not_identifier
    
    LOADIMM R3, 0x5A        ; 'Z'
    CMP R2, R3
    JG not_identifier
    
    ; 识别标识符
    LOADIMM R2, 1           ; TOK_IDENTIFIER
    JMP token_done
    
not_identifier:
    ; 检查数字
    LOADIMM R3, 0x30        ; '0'
    CMP R2, R3
    JL not_number
    
    LOADIMM R3, 0x39        ; '9'
    CMP R2, R3
    JG not_number
    
    LOADIMM R2, 2           ; TOK_NUMBER
    JMP token_done
    
not_number:
    ; 其他字符
    LOADIMM R2, 0           ; TOK_EOF
    
token_done:
    POP R7
    RET

token_end:
    LOADIMM R2, 0
    RET

; ==========================================
; 指令编码器
; ==========================================
encode_instruction:
    PUSH R7
    LOADIMM R7, 0
    
    ; R0 = 指令码
    ; R1-R3 = 操作数
    ; R4 = 输出缓冲区
    
    LOAD R5, code_ptr
    STORE R5, R0            ; 输出opcode
    
    ADD R5, R5, R7
    CMP R0, R7
    JE encode_done
    
    ; 根据指令类型输出操作数
    ; (简化版本)
    
encode_done:
    POP R7
    RET

; ==========================================
; 测试所有功能
; ==========================================
test_all:
    PUSH R7
    LOADIMM R7, 0
    
    CALL test_arithmetic
    CALL test_compare
    CALL test_loop
    CALL test_fibonacci
    CALL test_factorial
    
    POP R7
    RET

; ==========================================
; 测试算术运算
; ==========================================
test_arithmetic:
    PUSH R7
    LOADIMM R7, 0
    
    LOADIMM R0, str_arith
    PRINTS str_arith
    
    ; 100 + 200 = 300
    LOADIMM R0, 100
    LOADIMM R1, 200
    ADD R2, R0, R1
    PRINT R2
    
    ; 50 - 20 = 30
    LOADIMM R0, 50
    LOADIMM R1, 20
    SUB R2, R0, R1
    PRINT R2
    
    ; 6 * 7 = 42
    LOADIMM R0, 6
    LOADIMM R1, 7
    MUL R2, R0, R1
    PRINT R2
    
    ; 100 / 3 = 33
    LOADIMM R0, 100
    LOADIMM R1, 3
    DIV R2, R0, R1
    PRINT R2
    
    ; 100 % 3 = 1
    LOADIMM R0, 100
    LOADIMM R1, 3
    MOD R2, R0, R1
    PRINT R2
    
    POP R7
    RET

; ==========================================
; 测试比较运算
; ==========================================
test_compare:
    PUSH R7
    LOADIMM R7, 0
    
    LOADIMM R0, str_cmp
    PRINTS str_cmp
    
    LOADIMM R0, 10
    LOADIMM R1, 20
    CMP R0, R1
    JG cmp_greater
    
    ; 10 < 20
    LOADIMM R2, 0
    JMP cmp_done
cmp_greater:
    LOADIMM R2, 1
cmp_done:
    PRINT R2
    
    POP R7
    RET

; ==========================================
; 测试循环
; ==========================================
test_loop:
    PUSH R7
    LOADIMM R7, 0
    
    LOADIMM R0, str_loop
    PRINTS str_loop
    
    LOADIMM R0, 0           ; i = 0
    LOADIMM R1, 5           ; 循环5次
loop_i:
    CMP R0, R1
    JGE loop_end
    
    PRINT R0
    
    LOADIMM R2, 1
    ADD R0, R0, R2
    JMP loop_i
loop_end:
    
    POP R7
    RET

; ==========================================
; 测试斐波那契数列
; ==========================================
test_fibonacci:
    PUSH R7
    LOADIMM R7, 0
    
    LOADIMM R0, str_fib
    PRINTS str_fib
    
    LOADIMM R0, 0           ; a = 0
    LOADIMM R1, 1           ; b = 1
    
    PRINT R0
    PRINT R1
    
    LOADIMM R2, 8           ; 输出8个
    LOADIMM R3, 2           ; count = 2
fib_loop:
    CMP R3, R2
    JG fib_end
    
    ADD R4, R0, R1          ; c = a + b
    MOV R0, R1              ; a = b
    MOV R1, R4              ; b = c
    PRINT R1
    
    LOADIMM R4, 1
    ADD R3, R3, R4
    JMP fib_loop
fib_end:
    
    POP R7
    RET

; ==========================================
; 测试阶乘
; ==========================================
test_factorial:
    PUSH R7
    LOADIMM R7, 0
    
    LOADIMM R0, str_fact
    PRINTS str_fact
    
    LOADIMM R0, 5           ; 计算5!
    CALL factorial
    
    POP R7
    RET

; ==========================================
; 阶乘函数
; 输入: R0 = n
; 输出: R0 = n!
; ==========================================
factorial:
    PUSH R7
    PUSH R1
    PUSH R2
    
    LOADIMM R7, 1
    CMP R0, R7
    JNE fact_recur
    
    LOADIMM R0, 1
    JMP fact_return
    
fact_recur:
    MOV R1, R0              ; R1 = n
    LOADIMM R2, 1
    SUB R0, R0, R2          ; R0 = n-1
    CALL factorial
    MUL R0, R0, R1          ; R0 = n * fact(n-1)
    
fact_return:
    POP R2
    POP R1
    POP R7
    RET

; ==========================================
; 数据区
; ==========================================
.SECTION .rodata

str_banner:
.STR "================================"
.STR "\nFSG Compiler v1.0 - Bootstrap Edition"
.STR "\n================================"
.STR "\n"

str_done:
.STR "\n[Compiler Test Complete]\n"

str_arith:
.STR "\n--- Arithmetic Test ---\n"

str_cmp:
.STR "\n--- Compare Test ---\n"

str_loop:
.STR "\n--- Loop Test ---\n"

str_fib:
.STR "\n--- Fibonacci Test ---\n"

str_fact:
.STR "\n--- Factorial Test ---\n"

; ==========================================
; 符号表
; ==========================================
symbol_table:
.DW 0, 0, 0, 0, 0, 0, 0, 0
.DW 0, 0, 0, 0, 0, 0, 0, 0

; ==========================================
; 代码缓冲区
; ==========================================
code_buffer:
.DW 0, 0, 0, 0, 0, 0, 0, 0
.DW 0, 0, 0, 0, 0, 0, 0, 0
.DW 0, 0, 0, 0, 0, 0, 0, 0
.DW 0, 0, 0, 0, 0, 0, 0, 0

; ==========================================
; 指针变量
; ==========================================
sym_ptr:
.DW 0

code_ptr:
.DW 0

rodata_ptr:
.DW 0
