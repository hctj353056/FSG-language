; ==========================================
; FSG汇编编译器 v3.0 - 中文版
; 蜉熵阁 - 灵镜(ling)
; 支持: 载常/打印/跳转/比较/加/减/赋值/停止
; ==========================================

.全局 _start

_start:
    ; 打印版本 "FSG v3.0*"
    载常 R0, 70
    打印 R0
    载常 R0, 83
    打印 R0
    载常 R0, 71
    打印 R0
    载常 R0, 32
    打印 R0
    载常 R0, 118
    打印 R0
    载常 R0, 51
    打印 R0
    载常 R0, 46
    打印 R0
    载常 R0, 48
    打印 R0
    载常 R0, 42
    打印 R0
    
    ; 测试: 循环打印 1-5
    载常 R0, 1
循环:
    打印 R0
    载常 R1, 1
    加 R2, R0, R1
    赋值 R0, R2
    载常 R1, 5
    比较 R0, R1
    若大于跳转 结束
    跳转 循环
结束:
    载常 R0, 42
    打印 R0
    
    停止
