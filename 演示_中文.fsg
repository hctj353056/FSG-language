; ==========================================
; FSG汇编 - 中文版演示
; 蜉熵阁 - 灵镜(ling)
; ==========================================

.全局 _start

; ==========================================
; 主入口 - 打印 "你好 世界!"
; ==========================================
_开始:
    ; 打印 H (72)
    载常 R0, 72
    打印 R0
    
    ; 打印 e (101)
    载常 R0, 101
    打印 R0
    
    ; 打印 l (108)
    载常 R0, 108
    打印 R0
    
    ; 打印 l (108)
    载常 R0, 108
    打印 R0
    
    ; 打印 o (111)
    载常 R0, 111
    打印 R0
    
    ; 打印空格 (32)
    载常 R0, 32
    打印 R0
    
    ; 打印 世 (19990)
    载常 R0, 228
    打印 R0
    载常 R0, 184
    打印 R0
    载常 R0, 154
    打印 R0
    
    ; 打印 界 (30028)
    载常 R0, 231
    打印 R0
    载常 R0, 149
    打印 R0
    载常 R0, 140
    打印 R0
    
    ; 打印 ! (33)
    载常 R0, 33
    打印 R0
    
    ; 打印 * (42)
    载常 R0, 42
    打印 R0
    
    停止
